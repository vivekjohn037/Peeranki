{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peeranki",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/voice/*"
    ]
  },
  "previews": {},
  "main": "src/voice-worker.ts",
  "ratelimits": [
    {
      "name": "TURN_RATE_LIMITER",
      "namespace_id": "823791",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
